# Sao chép thành .env (KHÔNG commit .env). Chỉ commit tệp này với giá trị giả.
NODE_ENV=development
PORT=3000

# CSDL (khớp với docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5432/thuyetminh

# Xác thực
JWT_SECRET=doi-gia-tri-nay
JWT_EXPIRES_IN=3600

# Provider: mock | real
TRANSLATOR_PROVIDER=mock
TTS_PROVIDER=mock
# Khóa của dịch vụ dịch/TTS thật (nếu dùng)
TRANSLATOR_API_KEY=
TTS_API_KEY=

# Lưu file
STORAGE_DIR=./storage

# CORS: danh sách nguồn được phép, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173
