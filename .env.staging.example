# Template only. Never copy real staging credentials into validation runs.
BE04_POSTGRES_PASSWORD=replace_with_a_generated_password
BE04_APP_PASSWORD=replace_with_a_different_generated_password
BE04_SESSION_SECRET=replace_with_at_least_32_random_characters
BE04_UPLOADS_PATH=/absolute/path/to/dedicated/staging/uploads
BE04_MEDIA_LEGACY_ORIGINS=

# Existing staging defaults; override all four for an isolated BE10 run.
BE04_DB_NAME=hue_tourism_staging
BE04_HTTP_PORT=8080
BE04_BACKEND_IMAGE=hue-guide-backend:be04
BE04_FRONTEND_IMAGE=hue-guide-frontend:be04

# Leave empty for existing/restored staging. The BE10 validator generates these.
BE10_RUN_ID=
BE10_BOOTSTRAP_CONFIRM=
