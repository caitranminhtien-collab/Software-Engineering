FROM nginx:stable-alpine

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf

RUN rm -rf /usr/share/nginx/html/*

COPY frontend/index.html frontend/admin.html /usr/share/nginx/html/

COPY frontend/app.js \
     frontend/admin-auth.js \
     frontend/hue-admin-crud.js \
     frontend/hue-chat-api.js \
     frontend/hue-map.js \
     /usr/share/nginx/html/

COPY frontend/styles.css \
     frontend/theme.css \
     frontend/split.css \
     frontend/hue-map.css \
     /usr/share/nginx/html/

COPY frontend/assets /usr/share/nginx/html/assets

EXPOSE 80